#!/usr/bin/env python3
import sys
props = {}
for f in ("/system/build.prop", "/data/property/runtime.prop"):
    try:
        for line in open(f):
            line = line.strip()
            if line and not line.startswith("#") and "=" in line:
                k, v = line.split("=", 1); props[k] = v
    except OSError:
        pass
import time, json
try:
    v = json.load(open("/data/vendor/vhal/props.json"))
    props["vendor.tcu.body_ecu_online"] = str(v.get("BODY_ECU_ONLINE", False)).lower()
    props["vendor.tcu.last_sync"] = str(v.get("LAST_SYNC_UTC"))
except Exception:
    pass
props["sys.boot_completed"] = "1"
props["init.svc.adbd"] = "running"
props["init.svc.telematics"] = "running"
props["init.svc.vehicle-hal-2.0"] = "running"
if len(sys.argv) == 1:
    for k in sorted(props):
        print(f"[{k}]: [{props[k]}]")
else:
    print(props.get(sys.argv[1], sys.argv[2] if len(sys.argv) > 2 else ""))
